{
  "about": "거친 표현을 순한 표현으로 바꾸는 규칙. 확장의 순화, 고치기 메뉴의 추천, 학습 데이터 만들기에 함께 쓴다. pattern 은 JavaScript·Python 정규식에 모두 맞게 쓰고, to 의 $1 은 첫 번째 괄호 묶음이다. 뜻이 여럿인 말(강아지 새끼 등)은 앞뒤 말이 분명할 때만 바꾼다.",
  "rules": [
    {
      "pattern": "(?:개)?(?:존나|졸라|존니|존내|좆나|조낸|ㅈㄴ)",
      "to": "정말"
    },
    {
      "pattern": "개(?=(?:좋|웃기|웃김|웃겨|쩔|쩐|맛있|맛없|이쁘|예쁘|귀엽|멋있|많|비싸|빠르|느리|힘들|어렵|쉽|재밌|재미있|웃긴))",
      "to": "정말 "
    },
    {
      "pattern": "(?:개)?빡(?:치네|친다)",
      "to": "화가 나네"
    },
    {
      "pattern": "(?:개)?빡쳐",
      "to": "화가 나"
    },
    {
      "pattern": "(이|저|그|이런|저런|그런)\\s?(?:개)?(?:새끼|쉐끼|색기|섀끼|새기)(들)?",
      "to": "$1 사람$2"
    },
    {
      "pattern": "(이|저|그|이런|저런|그런)\\s?(?:놈|넘|년)(들)?(?=\\s|$|[.,!?~])",
      "to": "$1 사람$2"
    },
    {
      "pattern": "(?:병신|븅신|빙신)\\s?같은",
      "to": "형편없는"
    },
    {
      "pattern": "(?:병신|븅신|빙신)\\s?같이",
      "to": "형편없이"
    },
    {
      "pattern": "(?:좆|좃)\\s?같(?:다|네)",
      "to": "별로네"
    },
    {
      "pattern": "(?:좆|좃)\\s?같은",
      "to": "별로인"
    },
    {
      "pattern": "지랄(?:하네|한다|이네|이야)",
      "to": "난리네"
    },
    {
      "pattern": "(?:꺼져|닥쳐)",
      "to": "그만해"
    },
    {
      "pattern": "(?:쳐|처)(먹|자|웃|마시|울)",
      "to": "$1"
    },
    {
      "pattern": "이딴",
      "to": "이런"
    },
    {
      "pattern": "저딴",
      "to": "저런"
    }
  ]
}
